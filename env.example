# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it's already in .gitignore).

# ==== LLM Provider (Milestone 5) ====
# Choose "openai", "anthropic", or "gemini". All three are implemented in
# app/llm.py, so you only need an API key for the one you pick.
LLM_PROVIDER=anthropic

# OpenAI (used if LLM_PROVIDER=openai) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model names change often — check https://platform.openai.com/docs/models
# if this stops working. gpt-4.1-mini is a good low-cost default (2026).
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (used if LLM_PROVIDER=anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is a cheaper/faster alternative if you want lower cost.
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini (used if LLM_PROVIDER=gemini) — https://aistudio.google.com/app/apikey
# Has a free tier, good option if you don't want to pay for OpenAI/Anthropic.
GEMINI_API_KEY=
# Google deprecates old Gemini model versions fairly often — check
# https://ai.google.dev/gemini-api/docs/models if this stops working.
GEMINI_MODEL=gemini-3.5-flash

# ==== Embedding model (Milestone 2) ====
# Runs 100% locally via sentence-transformers — no API key or cost.
# First run downloads the model (~90 MB) from huggingface.co.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ==== Chunking (Milestone 1) ====
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ==== Retrieval (Milestone 4) ====
TOP_K=4

# ==== Storage (Milestone 3) ====
VECTOR_STORE_DIR=./data/vector_store
UPLOAD_DIR=./data/uploads

# ==== API security (Milestone 8) ====
# Clients must send this value in the "X-API-Key" header.
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_hex(24))"
APP_API_KEY=change-me-to-a-random-secret
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=20

# ==== Caching (Milestone 8) ====
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=86400

# ==== Logging (Milestone 8) ====
LOG_LEVEL=INFO
LOG_DIR=./logs
